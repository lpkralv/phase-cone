/-- The certified sequence of good gram blocks: every gram point and contained zero carries a
certificate, the blocks tile consecutively (`seq`), the total span clears the Lehman bound
(`wide`), and the range sits above `168π` (`high`). -/
abbrev certifiedGramBlockSeq : CertifiedGramBlockSeq where
  blocks := [blk1, blk2, blk3, blk4, blk5, blk6, blk7, blk8]
  seq := by
    simp only [List.isChain_cons_cons, List.isChain_singleton, and_true]
  cert := by
    intro b hb
    fin_cases hb
    · exact blk1_cert
    · exact blk2_cert
    · exact blk3_cert
    · exact blk4_cert
    · exact blk5_cert
    · exact blk6_cert
    · exact blk7_cert
    · exact blk8_cert
  non_empty := by simp
  wide := by
    change 5 + (0.128 : ℝ) * Real.log (gp9.snd / (2 * π)) < (gp9.fst - gp1.snd) / 2
    have hπ : (3.141592 : ℝ) < π := Real.pi_gt_d6
    have hX : ((gp9.snd : ℝ) / (2 * π)) ^ 1 < 2.718 ^ 5 := by
      rw [div_pow, div_lt_iff₀ (by positivity)]
      calc (gp9.snd : ℝ) ^ 1 < 2.718 ^ 5 * 6.283184 ^ 1 := by norm_num
        _ ≤ 2.718 ^ 5 * (2 * π) ^ 1 := by gcongr; linarith
    have he : (2.718 : ℝ) ^ 5 ≤ Real.exp 5 := by
      rw [show Real.exp 5 = Real.exp 1 ^ 5 by rw [← Real.exp_nat_mul]; norm_num]
      gcongr
      nlinarith [Real.exp_one_gt_d9]
    have hlog : (1 : ℝ) * Real.log (gp9.snd / (2 * π)) < 5 := by
      rw [show (1 : ℝ) * Real.log (gp9.snd / (2 * π))
          = Real.log (((gp9.snd : ℝ) / (2 * π)) ^ (1 : ℕ)) by rw [Real.log_pow]; norm_num]
      exact (Real.log_lt_iff_lt_exp (by positivity)).2 (hX.trans_le he)
    nlinarith [hlog]
  high := by
    change 168 * π < (529.11502 : ℝ)
    nlinarith [Real.pi_lt_d6]

